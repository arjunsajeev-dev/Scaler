# MQTT broker used by the Vite bridge (server-side; browsers cannot use :1883 TCP).
MQTT_URL=mqtt://127.0.0.1:1883

# Device whose discovery / status / lwt topics are followed.
MQTT_DEVICE_ID=scaler-hw-01

# From another Mac on the LAN, point at the broker host instead:
# MQTT_URL=mqtt://172.17.24.197:1883
