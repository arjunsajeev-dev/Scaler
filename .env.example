# Host-side orchestrator. Redis and the Docker socket proxy run in Compose
# and are published on localhost.

REDIS_URL=redis://127.0.0.1:6379/0
DOCKER_HOST=tcp://127.0.0.1:2375
DOCKER_NETWORK=scaler
SERVICES_CONFIG=config/services.yml
LOG_LEVEL=INFO

# MQTT. `mdns` finds a broker advertised as _mqtt._tcp on the LAN.
# This Mac also advertises itself as _scaler._tcp (MQTT_MDNS=true).
MQTT_HOST=mdns
MQTT_PORT=1883
MQTT_DEVICE_ID=scaler-hw-01
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_MDNS=true
MQTT_ADVERTISE_PORT=8000
